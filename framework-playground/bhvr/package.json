{
  "name": "bhvr-monorepo",
  "version": "0.0.1",
  "description": "A monorepo inspired by bhvr stack.",
  "type": "module",
  "workspaces": [
    "./client",
    "./server",
    "./shared"
  ],
  "scripts": {
    "dev:server": "bun run --cwd server dev",
    "dev:client": "bun run --cwd client dev",
    "dev": "bun --filter \"*\" dev"
  }
}
